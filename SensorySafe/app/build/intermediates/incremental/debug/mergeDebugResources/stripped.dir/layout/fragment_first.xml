<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sensory_light_grey"
    tools:context=".FirstFragment">

    <!-- Top app bar area with logo and menu icon -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/sensory_light_grey"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/logo_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/logo_icon"
                android:layout_width="40dp"
                android:layout_height="24dp"
                android:src="@mipmap/ic_launcher"
                android:tint="@android:color/black"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top blue background area -->
    <View
        android:id="@+id/top_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sensory_light_grey"
        app:layout_constraintTop_toBottomOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_background" />

    <!-- Bottom light background area -->
    <View
        android:id="@id/bottom_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sensory_light_grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_background" />

    <!-- Diagonal overlay approximating the angled transition -->
    <View
        android:id="@+id/diagonal_overlay"
        android:layout_width="1200dp"
        android:layout_height="260dp"
        android:background="@color/sensory_light_grey"
        android:rotation="-20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottom_nav" />

    <!-- Central circular measurement button (keeps id button_first for existing logic) -->
    <ImageButton
        android:id="@+id/button_first"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/measurement_button_background"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="@android:color/darker_gray"
        android:contentDescription="Start measuring"
        app:layout_constraintTop_toBottomOf="@id/bottom_nav"
        app:layout_constraintBottom_toTopOf="@+id/textview_first"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <!-- Measurement status / decibel readout -->
    <TextView
        android:id="@+id/textview_first"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="72dp"
        android:gravity="center"
        android:text="@string/measurement_initial"
        android:textColor="@color/sensory_text_primary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Home title above nav bar -->
    <TextView
        android:id="@+id/text_home_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/home_title_sensorysound"
        android:textColor="@color/sensory_text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="cursive"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top navigation bar with page icons and theme toggle -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/sensory_bottom_nav"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_home_title">

        <!-- Library helper (person with flag) -->
        <LinearLayout
            android:id="@+id/nav_library_helper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@android:color/black"
                android:contentDescription="Nearest library helper" />
        </LinearLayout>

        <!-- Decibel meter detail (eye icon) -->
        <LinearLayout
            android:id="@+id/nav_meter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_compass"
                android:tint="@android:color/black"
                android:contentDescription="Decibel level thermometer" />
        </LinearLayout>

        <!-- Threshold settings (gear icon) -->
        <LinearLayout
            android:id="@+id/nav_threshold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@android:color/black"
                android:contentDescription="Alert threshold" />
        </LinearLayout>

        <!-- Theme toggle (three lines icon) anchored to right of nav bar -->
        <ImageButton
            android:id="@+id/button_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@android:color/white"
            android:contentDescription="Toggle theme" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
